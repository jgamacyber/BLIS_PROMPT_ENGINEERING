# Chave da OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=coloque_sua_api_aqui

# Modelo de geração
MODEL=openai/gpt-4o-mini

# Temperatura 0 para comparar estratégias (isola o efeito do prompt).
# Use > 0 junto com --repeticoes para medir variância.
TEMPERATURE=0.0
MAX_TOKENS=700

# Quantas demonstrações usar no few-shot
K_FEWSHOT=3
REPETICOES=1

# APE (Automatic Prompt Engineer)
APE_CANDIDATOS=6
APE_TEMPERATURA=0.9
APE_RODADAS=2
APE_TOP_K=2
